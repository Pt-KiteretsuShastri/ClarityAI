# ClarityAI — Environment Configuration
# Copy this template and rename to .env for local development

# LLM Provider Settings
# Supported: "anthropic" or "openai"
CLARITY_AI_PROVIDER=anthropic

# API Key — get yours from:
#   Anthropic: https://console.anthropic.com
#   OpenAI:   https://platform.openai.com/api-keys
CLARITY_AI_API_KEY=

# Model override (optional)
#   Anthropic default: claude-3-haiku-20240307
#   OpenAI default:    gpt-4o-mini
# CLARITY_AI_MODEL=

# Custom base URL for OpenAI-compatible endpoints (optional)
# CLARITY_AI_BASE_URL=https://api.openai.com/v1
