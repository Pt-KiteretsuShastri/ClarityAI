# ClarityAI — Configuration
# Copy this file to configure your LLM provider

# Provider: "anthropic" or "openai"
CLARITY_AI_PROVIDER=anthropic

# Your API key
# Anthropic: https://console.anthropic.com
# OpenAI: https://platform.openai.com/api-keys
CLARITY_AI_API_KEY=

# Optional: Custom model override
# Anthropic: claude-3-haiku-20240307 (default), claude-3-5-sonnet-20241022
# OpenAI: gpt-4o-mini (default), gpt-4o
CLARITY_AI_MODEL=

# Optional: Custom base URL (for OpenAI-compatible endpoints)
CLARITY_AI_BASE_URL=
